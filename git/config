[alias]
  aa = add -A
  adc = !git aa && git dc
  amend = commit --amend
  b = branch
  co = checkout
  coauth = "!f() { git log --format='Co-Authored-By: %an <%ae>' $1 | sort | uniq; }; f"
  cp = cherry-pick
  d = diff
  date = "!f() { git log --format='%C(bold blue)%h %C(bold green)%ai%C(reset) %ar' --max-count=1 $(git rev-list -n1 $1); }; f"
  dc = diff --cached
  dh = diff --cached HEAD^
  dm = "!f() { git diff $(git merge-base HEAD main); }; f"
  ds = diff --cached --stat
  dsm = diff --stat main
  fat = fetch --all --tags
  grepa = "!f() { git grep \"$@\" $(git rev-list --all); }; f"
  lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
  lg2 = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all
  ls = log --graph --simplify-by-decoration --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
  lm = log --author="116@lab0.net" --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)' --all
  pat = pull --all --tags
  puff = pull --ff-only
  r = restore
  rbs = "!f() { git rebase origin/$(git rev-parse --abbrev-ref HEAD); }; f"
  ri = rebase -i
  rs = restore --staged
  s = status
  quick-stats = /usr/local/bin/git-quick-stats
  root = rev-parse --show-toplevel
  wip = "!f() { git commit -am \"WiP: $*\"; }; f"

[color]
  diff = auto
  status = auto
  branch = auto
  interactive = auto
  ui = true
  pager = true

[core]
  pager = delta
  excludesFile = ~/.gitignore
  editor = nvim

[credential]
	helper = cache --timeout=36000

[delta]
    plus-color = "#012800"
    minus-color = "#340001"
    syntax-theme = Monokai Extended
    pager=less

[interactive]
  diffFilter = delta --color-only

[merge]
#  tool = kdiff3
  tool = intellij

[mergetool "intellij"]
  cmd = '/home/uuh/.local/bin/idea' merge "$REMOTE" "$LOCAL" "$BASE" "$MERGED"
  trustExitCode = true

[mergetool]
  keepBackup = false

[init]
  defaultBranch = master

[includeIf "gitdir:/home/uuh/dev/"]
  path = config-home

[includeIf "gitdir:/home/uuh/dev/sovity/"]
  path = config-sovity

[includeIf "gitdir:/home/uuh/dev/ununhexium/autolang/"]
  path = config-autolang

